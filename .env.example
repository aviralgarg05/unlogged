# PayPal sandbox REST app — developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# OpenAI — only needed for the adjudication layer. Everything else runs without it,
# and the keyword baseline (the eval's ablation arm) runs with no key at all.
OPENAI_API_KEY=

# Replay recorded PayPal exchanges instead of calling the live sandbox.
# This is the default path for anyone running the project without credentials.
UNLOGGED_REPLAY=1
