# PayPal sandbox REST app — developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# OpenAI — only needed for the adjudication layer. Everything else runs without it,
# and the keyword baseline (the eval's ablation arm) runs with no key at all.
OPENAI_API_KEY=

# Replay recorded PayPal exchanges instead of calling the live sandbox.
# This is the default path for anyone running the project without credentials.
UNLOGGED_REPLAY=1

# Where the ledger lives. Defaults to data/.
# UNLOGGED_DATA=data

# The webhook subscription id PayPal signs with. Only needed to verify a genuine delivery:
# without it /webhook rejects every non-simulated payload with 400. Sandbox app > Webhooks.
# PAYPAL_WEBHOOK_ID=

# 1 writes what a live call returns into cassettes/. Left commented out on purpose: the
# recordings are the evidence every money claim in this repo rests on, and recording used to
# be a side effect of reaching the network — one live run rewrote them and the demo replayed
# USD 1.00 with no error anywhere. Turn it on only when you mean to re-record.
# UNLOGGED_RECORD=1

# `unlogged pull-github` reads a public repository with no token at all. A token raises the
# rate limit from 60 requests an hour to 5000, and is required for a private one.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name
