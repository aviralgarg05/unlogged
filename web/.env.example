# Copy to .env.local. Everything here is optional: with none of it, the dashboard renders, the
# grids page against the Python service, and the AI assistant is hidden.
#
# No PayPal credentials belong in this file. The web app never talks to PayPal — the Python
# service does, and it reads its own .env one directory up. That separation is the point: a
# PayPal credential has no business in anything that serves a browser.

# The AG Studio AI assistant. Read server-side only — there is deliberately no NEXT_PUBLIC_
# variable for it, so it is never inlined into the browser bundle. Falls back to
# OPENAI_API_KEY if this is blank.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated model ids for the assistant's picker; the first is the default. Two or more
# turn the picker on. These are the ids this project actually uses.
OPENAI_MODELS=gpt-6.1-sol,gpt-5.4-mini

# Where the Python service is listening. A value with no scheme is read as a host and given
# https://, because a Render blueprint cannot interpolate one — see lib/backend-origin.ts.
UNLOGGED_API=http://127.0.0.1:8000

# Optional AG Studio licence key. Leave it blank: validateLicense() only ever sets a watermark
# message, isDisplayWatermark() returns false on localhost, and a trial key can expire during
# judging whereas no key cannot. See the README.
AG_STUDIO=
