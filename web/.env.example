# The dashboard's own environment. Copy to web/.env.local, which is gitignored.
#
# None of this is required: with no key the dashboard renders, the grids page from the Python
# service and the assistant is simply hidden.

# Enables the AG Studio assistant. Read server-side only — there is deliberately no
# NEXT_PUBLIC_ variable for it, so it is never inlined into the browser bundle. Falls back to
# OPENAI_API_KEY if that is set instead.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated. Two or more turns on the model picker in the chat panel.
OPENAI_MODELS=gpt-6.1-sol,gpt-5.4-mini

# Where the Python service is listening. Defaults to http://127.0.0.1:8000. A value with no
# scheme is read as a host and https:// is put in front of it, because a Render blueprint
# cannot interpolate one — see lib/backend-origin.ts.
# UNLOGGED_API=http://127.0.0.1:8000

# An AG Studio Pro licence key, if you have one. Without it every feature is unlocked for
# trial and the watermark is suppressed on localhost, so none is needed here.
# AG_STUDIO=
