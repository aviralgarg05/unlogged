# Same rule as web/.dockerignore: the build context must not carry credentials, recorded
# evidence, or a ledger. .env holds live PayPal and OpenAI keys; data/ holds what has been
# billed to a real invoice.
.env
.env.*
!.env.example

.git
.venv
__pycache__
*.pyc
# The live ledger and the webhook log stay out; the seed does not. Excluding the whole
# directory kept data/seed/ out of the image too, and that file is the only thing standing
# between a `docker compose up` demo and a blank page where the billed lines should be.
data/*.jsonl
data/*.lock
evals
web/node_modules
web/.next
docs/img
.DS_Store
